{
  "entities": {
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Entity used to validate Firebase Firestore connectivity on application boot",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Connection status message"
        },
        "measuredAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the connection was verified"
        }
      },
      "required": ["status", "measuredAt"]
    },
    "HeroTrailer": {
      "title": "HeroTrailer",
      "description": "Premium cinematic trailers with associated logos intended for the hero section of the landing page.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "malId": { "type": "number" },
        "anilistId": { "type": "number" },
        "trailerUrl": { "type": "string", "format": "uri" },
        "logoUrl": { "type": "string", "format": "uri" },
        "order": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["title", "malId", "anilistId", "trailerUrl", "logoUrl", "order", "active"]
    },
    "AnimeSection": {
      "title": "AnimeSection",
      "description": "User's compiled Anime lists",
      "type": "object",
      "properties": {
        "library": { "type": "array" },
        "watchHistory": { "type": "array" },
        "watchLater": { "type": "array" }
      }
    },
    "MoviesSection": {
      "title": "MoviesSection",
      "description": "User's compiled Movie lists",
      "type": "object",
      "properties": {
        "library": { "type": "array" },
        "watchHistory": { "type": "array" },
        "watchLater": { "type": "array" }
      }
    },
    "SeriesSection": {
      "title": "SeriesSection",
      "description": "User's compiled Series lists",
      "type": "object",
      "properties": {
        "library": { "type": "array" },
        "watchHistory": { "type": "array" },
        "watchLater": { "type": "array" }
      }
    },
    "UserDocument": {
      "title": "UserDocument",
      "description": "The unified root user profile document containing anime, movies, and series configurations.",
      "type": "object",
      "properties": {
        "anime": { "$ref": "AnimeSection" },
        "movies": { "$ref": "MoviesSection" },
        "series": { "$ref": "SeriesSection" }
      }
    }
  },
  "firestore": {
    "test": {
      "schema": "ConnectionTest",
      "description": "Collection used for system connection checks"
    },
    "heroTrailers": {
      "schema": "HeroTrailer",
      "description": "Contains metadata for hero section premium trailers."
    },
    "users": {
      "schema": "UserDocument",
      "description": "The master users collection housing all isolated client libraries, history tables, and lists by userId."
    }
  }
}
